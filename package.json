    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "eslint-plugin-vitest": "^0.5.4",
    "graphql-codegen-typescript-mock-data": "^5.2.0",
